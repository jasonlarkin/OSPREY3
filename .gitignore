# ad-hoc local scripts/results (repo-root)
/benchmark_simd.sh
/verify_avx512.sh

# committed notes/docs live in notes/
# ignore only explicitly-local scratch subdirs
/notes/.local/
/notes/.scratch/

# optional local-only notes outside the committed tree
/notes_local/

# local nested clones (keep out of git)
/osprey-fork_main/

# pipeline analysis: keep curated *.md + small *.py runners, ignore raw outputs
/pipeline_analysis/**/*.prof
/pipeline_analysis/**/*.txt
/pipeline_analysis/**/*.log
/pipeline_analysis/**/*.out
/pipeline_analysis/**/*.png
/pipeline_analysis/**/*.json
/pipeline_analysis/**/*.html
